{
  "name": "@wingravity/typerail",
  "version": "0.2.0",
  "description": "Finds TypeScript code that type-checks and still fails at runtime. One command, no configuration, and coding agents cannot switch it off.",
  "license": "MIT",
  "author": "Daniel Berigoi",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wingravity/typerail.git"
  },
  "homepage": "https://github.com/wingravity/typerail#readme",
  "bugs": {
    "url": "https://github.com/wingravity/typerail/issues"
  },
  "engines": {
    "node": ">=20.3"
  },
  "bin": {
    "typerail": "dist/cli/main.js"
  },
  "exports": {
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "default": "./dist/eslint/index.js"
    },
    "./tsconfig.json": "./config/tsconfig.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "config",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "eslint .",
    "typerail": "node src/cli/main.ts check",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run typerail && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@typescript-eslint/rule-tester": "8.73.0",
    "@typescript-eslint/utils": "8.73.0"
  },
  "dependencies": {
    "@typescript-eslint/type-utils": "^8.30.0",
    "@typescript-eslint/types": "^8.30.0",
    "eslint": "^9.35.0 || ^10.0.0",
    "typescript": ">=5.8.0 <6.1.0",
    "typescript-eslint": "^8.30.0"
  },
  "keywords": [
    "typescript",
    "eslint",
    "eslint-plugin",
    "type-safety",
    "soundness",
    "linter",
    "coding-agents",
    "ai-agents",
    "guardrails",
    "claude-code",
    "codex",
    "cursor"
  ],
  "publishConfig": {
    "access": "public"
  }
}
